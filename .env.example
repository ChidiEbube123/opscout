# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-project.vercel.app

# --- Supabase Postgres ---
# Use the "Connection Pooling" (port 6543, pgbouncer) URI from Supabase
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.xxxxxxxx:[email protected]:6543/postgres

# --- Gemini API (free tier) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Scout tuning ---
OPPORTUNITY_ARCHIVE_AFTER_DAYS=1
